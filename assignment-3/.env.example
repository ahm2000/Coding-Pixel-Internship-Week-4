# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Server-only. Read by src/app/api/config/route.ts via src/lib/config.ts.
# Never prefixed with NEXT_PUBLIC_, so it's invisible to the browser bundle.
API_BASE_URL=

# Safe to expose: it's just a display string, no security implication.
# NEXT_PUBLIC_ ships this to every visitor's browser, permanently.
NEXT_PUBLIC_SITE_NAME=
